# Discaro environment — copy to .env.local and fill in.
# Supabase dashboard → Project Settings → API. The publishable key is
# safe to expose publicly; Row Level Security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Google Analytics 4 Measurement ID (public identifier, e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Resend — newsletter sending (server-only secrets, set in Vercel, never commit)
RESEND_API_KEY=
RESEND_FROM=Discaro <onboarding@resend.dev>
